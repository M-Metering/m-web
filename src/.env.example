# ME Metering — build-time configuration.
# Copy this file to src/.env and adjust as needed (Vite reads env files from src/).
# Both values are baked into the build; changing them needs a rebuild.

# API origin, without /api/v1.
VITE_API_BASE_URL=https://api.memetering.com

# Optional: the origin of the storage bucket that uploaded photos redirect to
# (the Location of a GET /files/{token} response, e.g. https://<bucket-host>).
# Lets the Completed Installations export embed photos. Without it the export
# still includes every photo's link. Never put credentials here.
# VITE_FILE_STORAGE_ORIGIN=

# API documentation: https://api.memetering.com/api-docs
